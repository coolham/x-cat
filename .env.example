# X-Cat Environment Variables
# Copy this file to .env and fill in your values

# Telegram API credentials
XCAT_TELEGRAM_API_KEY=your_telegram_api_key_here
XCAT_TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# OpenAI API credentials
XCAT_OPENAI_API_KEY=your_openai_api_key_here

# Storage settings
XCAT_STORAGE_DB_PATH=data/storage.db
XCAT_STORAGE_BACKUP_DIR=data/backups

# System settings
XCAT_SYSTEM_TIMEZONE=Asia/Shanghai
XCAT_SYSTEM_LOG_LEVEL=INFO

# X-Cat系统配置示例
# 复制此文件为.env并填写相应的值

# X-Cat配置
TIMEZONE=Asia/Shanghai

# 系统配置
LOG_LEVEL=DEBUG
DATA_DIR=data
LOG_DIR=logs

# AI API配置
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_USE_PROXY=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_USE_PROXY=true   
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_USE_PROXY=false

# 代理服务器配置（如需）
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808

# 存储配置
DB_PATH=data/storage.db
BACKUP_DIR=data/backups
MAX_BACKUPS=10

# 内容分析配置
SUMMARY_MAX_LENGTH=100
CONTENT_MAX_LENGTH=15000

# Telegram配置
TELEGRAM_API_KEY=your_telegram_api_key_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here
TELEGRAM_USE_PROXY=true

# 微信配置
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here
WECHAT_USE_PROXY=true

# Preprocessor配置
PREPROCESSOR_USE_PROXY=true

# Twitter API配置
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# 日志级别
LOG_LEVEL=INFO

# 数据存储
SQLITE_DB=x-cat.db

# Telegram配置
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_SESSION_NAME=x_cat_session

# 监控的频道/群组（可选，不填则监控所有消息）
# 格式: 频道1,频道2,频道3
TELEGRAM_MONITOR_CHATS=

#----------------------------------------
# AI服务配置（至少配置一个）
#----------------------------------------

# OpenAI API配置
# OPENAI_MODEL=gpt-3.5-turbo  # 可选，默认使用gpt-3.5-turbo

# OpenRouter API配置 (可访问多种模型)
# OPENROUTER_MODEL=openrouter:gpt-3.5-turbo  # 可选

# DeepSeek API配置
# DEEPSEEK_MODEL=deepseek-chat  # 可选

#----------------------------------------
# 代理服务器配置（可选）
#----------------------------------------
# 如果您需要通过代理访问API或其他网络资源
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

#----------------------------------------
# 内容分析配置
#----------------------------------------
# 最大处理内容长度（字符数）
MAX_CONTENT_LENGTH=8000
# 最大生成token数
MAX_TOKENS=2000
# 温度参数（0.0-1.0，越高越随机）
TEMPERATURE=0.7

# 飞书配置
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_RAW_FOLDER_TOKEN=your_feishu_raw_folder_token_here
FEISHU_PROCESSED_FOLDER_TOKEN=your_feishu_processed_folder_token_here

# 代理配置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# TELEGRAM_USE_PROXY=true 