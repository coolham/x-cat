# X-Cat系统配置示例
# 复制此文件为.env并填写相应的值

# 日志级别
LOG_LEVEL=INFO

# 数据存储
DATA_DIR=./data
SQLITE_DB=x-cat.db

# Telegram配置
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_SESSION_NAME=x_cat_session

# 监控的频道/群组（可选，不填则监控所有消息）
# 格式: 频道1,频道2,频道3
TELEGRAM_MONITOR_CHATS=

#----------------------------------------
# AI服务配置（至少配置一个）
#----------------------------------------

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-3.5-turbo  # 可选，默认使用gpt-3.5-turbo
# OPENAI_USE_PROXY=true  # 可选，控制是否使用代理

# OpenRouter API配置 (可访问多种模型)
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=openrouter:gpt-3.5-turbo  # 可选
# OPENROUTER_USE_PROXY=true  # 可选，控制是否使用代理

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-chat  # 可选
# DEEPSEEK_USE_PROXY=true  # 可选，控制是否使用代理

#----------------------------------------
# 代理服务器配置（可选）
#----------------------------------------
# 如果您需要通过代理访问API或其他网络资源
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

#----------------------------------------
# 内容分析配置
#----------------------------------------
# 最大处理内容长度（字符数）
MAX_CONTENT_LENGTH=8000
# 最大生成token数
MAX_TOKENS=2000
# 温度参数（0.0-1.0，越高越随机）
TEMPERATURE=0.7 