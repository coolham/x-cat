{
  "system": {
    "log_level": "INFO",
    "log_file": "logs/xcat.log",
    "data_dir": "data",
    "worker_threads": 4,
    "health_check_interval": 30
  },
  "telegram_adapter": {
    "api_key": "YOUR_TELEGRAM_API_KEY",
    "channel_id": "YOUR_CHANNEL_ID",
    "proxy_url": "http://127.0.0.1:7890",
    "polling_interval": 60,
    "processed_messages_file": "data/processed_messages.txt"
  },
  "gpt_analyzer": {
    "api_key": "YOUR_OPENAI_API_KEY",
    "model": "gpt-4",
    "proxy_url": "http://127.0.0.1:7890",
    "max_tokens": 1000,
    "temperature": 0.3,
    "cache_dir": "data/gpt_cache",
    "categories": ["AI", "Python", "电子设计", "数字货币", "其他"],
    "prompt_template": "对以下X帖子进行分类，并生成一句话摘要：\n\n{text}\n\n分类应为以下类别之一：{categories}。",
    "backup_provider": "anthropic",
    "anthropic_api_key": "YOUR_ANTHROPIC_API_KEY"
  },
  "discord_adapter": {
    "enabled": false,
    "token": "YOUR_DISCORD_BOT_TOKEN",
    "guild_id": "YOUR_DISCORD_GUILD_ID",
    "channel_id": "YOUR_DISCORD_CHANNEL_ID"
  },
  "rss_adapter": {
    "enabled": false,
    "feeds": [
      {
        "url": "https://example.com/feed.xml",
        "name": "Example Feed",
        "check_interval": 3600
      }
    ]
  },
  "storage": {
    "db_type": "sqlite",
    "db_path": "data/xcat.db",
    "backup_dir": "data/backups",
    "backup_interval": 86400,
    "max_backups": 7
  },
  "web_ui": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8080,
    "username": "admin",
    "password": "YOUR_PASSWORD",
    "secret_key": "YOUR_SECRET_KEY"
  }
} 