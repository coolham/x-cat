# 代理服务器配置
# 请取消注释并修改为您使用的代理服务器地址

# HTTP/HTTPS代理示例
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=http://localhost:1080

# SOCKS5代理示例 (常见于Shadowsocks/V2Ray等)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=socks5h://127.0.0.1:1080  # socks5h会将DNS请求也通过代理解析

# 需要认证的代理
# TELEGRAM_PROXY=http://username:password@proxy-server:port
# TELEGRAM_PROXY=socks5://username:password@proxy-server:port

# 日志设置
