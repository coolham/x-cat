{
    "data_source": {
        "type": "telegram",
        "api_key": "test_key",
        "channel_id": "test_channel",
        "processed_messages_file": "data/test_processed_messages.txt",
        "polling_interval": 10,
        "mock_mode": true,
        "category_channels": {
            "AI": "ai_channel",
            "Python": "python_channel",
            "电子设计": "electronics_channel",
            "数字货币": "crypto_channel",
            "其他": "other_channel"
        }
    },
    "analyzer": {
        "type": "gpt",
        "api_key": "test_gpt_key",
        "model": "gpt-4",
        "categories": ["AI", "Python", "电子设计", "数字货币", "其他"],
        "max_tokens": 150,
        "temperature": 0.2
    },
    "storage": {
        "type": "local",
        "db_path": "data/test_xcat.db"
    },
    "logging": {
        "level": "DEBUG",
        "file": "logs/test_xcat.log"
    }
} 